{
  "name": "dsh-web-search-searxng",
  "version": "0.1.1",
  "description": "SearXNG search provider plugin for DeepSeek Harness (self-hosted SearXNG meta-search with quality reranking).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckyyzh/dsh-web-search-searxng.git"
  },
  "author": "luckyyzh",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "search",
    "searxng",
    "web-search"
  ],
  "license": "MIT"
}
